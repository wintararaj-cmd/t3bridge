{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t3Bridge",
  "version": "0.2.0",
  "identifier": "com.t3bridge.desktop",
  "build": {
    "beforeBuildCommand": "cargo build --release -p t3_service",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "t3Bridge — Universal P2P Business Application Bridge",
        "width": 780,
        "height": 750,
        "resizable": false,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "wintun.dll": "wintun.dll",
      "../target/release/t3bridge-service.exe": "t3bridge-service.exe"
    }
  }
}
