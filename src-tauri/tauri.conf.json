{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t3Bridge",
  "version": "0.1.0",
  "identifier": "com.t3bridge.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "t3Bridge — Universal P2P Business Application Bridge",
        "width": 780,
        "height": 650,
        "resizable": false,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
